# CloudFront domain that serves marketing assets such as the landing page demo video.
NEXT_PUBLIC_MARKETING_CDN_URL=https://your-distribution.cloudfront.net
# PostHog project token for marketing analytics (public); same project as the app in each environment
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
