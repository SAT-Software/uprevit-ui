# PostHog project token for marketing analytics (public); same project as the app in each environment
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Backend API Gateway base URL for proxying /api/contact (defaults to dev API in development)
API_PROXY_TARGET=https://weh8ywxicg.execute-api.us-east-1.amazonaws.com/Prod
# Cloudflare Turnstile site key for the contact form widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile site key for the blog newsletter widget
NEXT_PUBLIC_NEWSLETTER_TURNSTILE_SITE_KEY=
